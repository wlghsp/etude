FROM alpine:3.19

# kubectl 버전을 고정한다 (stable 최신을 받으면 이미지를 다시 만들 때마다 버전이 바뀐다). 올릴 때는 이 값만 바꾼다.
ARG KUBECTL_VERSION=v1.36.2
RUN apk add --no-cache curl bash bash-completion && \
    curl -LO "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/arm64/kubectl" && \
    chmod +x kubectl && mv kubectl /usr/local/bin/kubectl && \
    export VERIFY_CHECKSUM=false && curl https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash

WORKDIR /root
CMD ["bash"]