#!/usr/bin/perl
# 퀘스트용 작은 HTTP 서버. 사용법: etude-httpd PORT
#   /health → 503 down,  POST → "got:<본문>",  그 외 → 200 healthy (헤더 X-Env: prod)
use strict; use warnings; use IO::Socket::INET;
$SIG{PIPE} = 'IGNORE'; $SIG{CHLD} = 'IGNORE';
my $port = shift or die "usage: etude-httpd PORT\n";
my $s = IO::Socket::INET->new(Listen => 20, LocalPort => $port, ReuseAddr => 1, Proto => 'tcp') or die "bind: $!\n";
while (my $c = $s->accept) {
    my $pid = fork;
    if ($pid) { close $c; next }
    my $req = <$c> // '';
    my ($m, $path) = split ' ', $req;
    $m //= ''; $path //= '/';
    my %h;
    while (my $l = <$c>) { $l =~ s/\r?\n$//; last if $l eq ''; $h{lc $1} = $2 if $l =~ /^([^:]+):\s*(.*)$/ }
    my $body = '';
    read($c, $body, $h{'content-length'}) if ($h{'content-length'} || 0) > 0;
    my ($code, $text, $out) = (200, 'OK', 'healthy');
    if ($path eq '/health') { ($code, $text, $out) = (503, 'Service Unavailable', 'down') }
    elsif ($m eq 'POST') { $out = "got:$body" }
    my $len = length $out;
    print $c "HTTP/1.1 $code $text\r\nContent-Type: text/plain\r\nX-Env: prod\r\nContent-Length: $len\r\nConnection: close\r\n\r\n";
    print $c $out unless $m eq 'HEAD';
    close $c; exit 0;
}
