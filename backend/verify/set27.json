{
  "setId": 27,
  "answers": {
    "1": "ps -eo pid,rss,args --sort=-rss | head -n 4 > /tmp/mem_top3.txt",
    "2": "free -m | awk '/^Mem:/ {print $7}' > /tmp/avail.txt\n",
    "3": "awk '/MemTotal/ {printf \"%d\", $2/1024}' /proc/meminfo > /tmp/mem_total.txt\n",
    "4": "nproc > /tmp/cores.txt\n",
    "5": "top -b -n 1 > /tmp/top.txt\n",
    "6": "awk -F'load average: ' '{print $2}' /tmp/uptime.txt | cut -d, -f3 | tr -d ' ' > /tmp/load15.txt\n",
    "7": "vmstat 1 3 > /tmp/vmstat.txt\n",
    "8": "awk 'NR>1 && $5+0>=80 {print $6}' /tmp/df.txt | sort > /tmp/full.txt\n",
    "9": "awk 'NR>1 && $5==\"100%\" {print $6}' /tmp/dfi.txt > /tmp/inode_full.txt\n",
    "10": "awk 'NR>1 && $2 ~ /^nfs/ {print $7}' /tmp/dft.txt | sort > /tmp/nfs_mounts.txt\n",
    "11": "grep nfs /tmp/mounts.txt | grep -o -E 'hard|soft' > /tmp/nfs_mode.txt\n",
    "12": "echo '10.0.0.5:/export/data /mnt/data nfs4 defaults,_netdev 0 0' >> /etc/fstab\n",
    "13": "echo '/export/data 10.0.0.0/24(rw,sync,no_root_squash)' >> /etc/exports\n",
    "14": "printf '%s\\n' /export/data /export/public | sort > /tmp/my_exports.txt\n"
  }
}
