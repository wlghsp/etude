    "3": "echo \"export APP_HOME=/opt/myapp\" > /etc/profile.d/myapp.sh",
    "4": "useradd -r -s /sbin/nologin myservice",
    "5": "echo \"192.168.1.100 db.internal\" >> /etc/hosts",
    "6": "ss -tlnp > /tmp/ports.txt",
    "7": "tar -czf /tmp/etc_backup.tar.gz /etc 2>/dev/null || true",
    "8": "mkdir -p /opt/mytool/bin && echo \"export PATH=$PATH:/opt/mytool/bin\" > /etc/profile.d/mytool.sh",
    "9": "chmod +x /opt/myapp/start.sh",
    "10": "useradd -r -s /sbin/nologin myservice 2>/dev/null || true && chown -R myservice:myservice /opt/myapp",
